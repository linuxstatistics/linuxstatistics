# Copy to .env for local overrides. Never commit .env.
# Leave DATABASE_URL unset to use the local PGlite database in .data/pglite.
# DATABASE_URL=postgres://linuxstats:linuxstats@localhost:5432/linuxstats
# GitHub token (read-only, public repos) for the github source; optional locally.
# GITHUB_TOKEN=
# Site build: where the API is, and the public URL.
# API_URL=http://localhost:3001
# SITE_URL=https://linuxstatistics.com
