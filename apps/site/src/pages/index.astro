---
import { DistroMark } from "../components/DistroMark";
import SwitchSide from "../components/SwitchSide.astro";
import Base from "../layouts/Base.astro";
import { ListView } from "../components/ListView";
import { Podium } from "../components/Podium";
import { SponsorCard } from "../components/SponsorCard";
import { loadDistros, loadMarketShare, loadMeta, loadRising, loadStats, dataDate } from "../lib/data";
import { SWITCHERS_HOME_THRESHOLD } from "../config/stats";
import { buildHeadline, joinNames, topRanked } from "../lib/headline";
import { itemListNode } from "../lib/structured-data";
import { RANK_SOURCE, RANK_VALUE_LABEL } from "@linux-statistics/shared";
import { latestLinuxShare, linuxYearlySeries } from "../lib/marketShare";
import { ShareChart } from "../components/ShareChart";
import { LIST_PATH, packList } from "../lib/distro-list";

const [items, marketShare, meta, rising, stats] = await Promise.all([loadDistros(), loadMarketShare(), loadMeta(), loadRising(), loadStats()]);
const switchers = stats.site.switchers.total >= SWITCHERS_HOME_THRESHOLD ? stats.site.switchers.total : null;
const asOf = dataDate(meta, "wikipedia");
const site = Astro.site!.href.replace(/\/$/, "");
const headline = buildHeadline(items);
const share = latestLinuxShare(marketShare);
const restItems = items.filter((d) => d.rank === null || d.rank > 3);
// The HTML carries the first page of the table (rank order, as the table sorts by default); the rest loads from LIST_PATH.
const FIRST_PAGE = 47;
const firstRows = [...restItems].sort((a, b) => (a.rank ?? Infinity) - (b.rank ?? Infinity)).slice(0, FIRST_PAGE);
const podiumSlugs = items.filter((d) => !restItems.includes(d)).map((d) => d.slug);

const title = headline
  ? `${headline.leader} is #1. Linux distro rankings | LinuxStatistics`
  : "Linux distro rankings and statistics | LinuxStatistics";
const top5 = topRanked(items, 5);
const top10 = topRanked(items, 10);
const monthLabel = asOf ? new Date(`${asOf.slice(0, 10)}T00:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" }) : null;
const description = top5.length >= 3
  ? `The most popular Linux distros right now: ${joinNames(top5.map((d) => d.name))}. Rankings for ${items.length} distributions from an open interest index.`
  : `Rankings for ${items.length} Linux distributions: popularity, last month's movers, desktop market share, GitHub activity and community ratings, plus a quiz to pick one.`;
const dataset = {
  "@type": "Dataset",
  name: "Linux distribution rankings",
  description,
  url: `${site}/`,
  ...(asOf ? { dateModified: asOf } : {}),
  // Data licence, not the code licence (the code is AGPL-3.0).
  license: "https://creativecommons.org/licenses/by/4.0/",
  distribution: [{ "@type": "DataDownload", encodingFormat: "application/json", contentUrl: `${site}/data/distros.json` }],
  isBasedOn: [
    "https://en.wikipedia.org/",
    "https://distrowatch.com/dwres.php?resource=popularity",
    "https://gs.statcounter.com/os-market-share/desktop/worldwide",
    "https://github.com/",
  ],
  // Spelled out in full: Google's Dataset check doesn't resolve an @id-only reference.
  creator: { "@type": "Organization", "@id": `${site}/#org`, name: "LinuxStatistics", url: `${site}/` },
};
// Top 10 in rank order; all ten are visible on the page (podium #1-3, table #4-10).
const jsonLd = {
  "@graph": [
    dataset,
    ...(top10.length ? [itemListNode(site, "Top Linux distributions by interest score", top10.map((d) => ({ name: d.name, href: `/distro/${d.slug}/` })))] : []),
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="mast">
    {headline ? (
      <h1>
        {headline.leader} holds <em>#1</em>.
        {headline.mover && <span class="sub"><b>{headline.mover.name}</b> {headline.mover.text}</span>}
      </h1>
    ) : (
      <h1>Linux distro rankings</h1>
    )}
    {top5.length >= 3 && (
      <p class="mast-answer">
        Top Linux distros{monthLabel ? `, ${monthLabel}` : ""}:{" "}
        {top5.map((d, i) => (
          <>{i > 0 ? ", " : ""}{d.rank}. <a href={`/distro/${d.slug}/`}>{d.name}</a> ({d.hitsPerDay?.toLocaleString("en-US") ?? "-"})</>
        ))}.
      </p>
    )}
    <p class="mast-note">Ranked by interest, not installs: Wikipedia views, GitHub stars and more, combined in an <a href="/about/#ranking">open index</a>. <a href="/about/#interest-not-installs">Why not page hits?</a></p>
    {switchers != null && <p class="mast-switchers"><a href="/stats/">{switchers.toLocaleString("en-US")} people say LinuxStatistics helped them switch to Linux</a></p>}
  </div>

  <div class="home">
    <section aria-label="Rankings">
      <Podium items={items} />
      <div class="sec"><h2>Full ranking, #4 onward</h2><span class="sec-sub">{RANK_VALUE_LABEL[RANK_SOURCE].toLowerCase()}, last 12 months<button type="button" class="rank-explainer-btn" popovertarget="rank-explainer" aria-label="What do these numbers mean?" title="What do these numbers mean?"></button></span></div>
      <ListView client:load packed={JSON.stringify(packList(firstRows))} src={LIST_PATH} exclude={podiumSlugs} total={restItems.length} maxHits={Math.max(1, ...items.map((d) => d.hitsPerDay ?? 0))} firstPage={FIRST_PAGE} pageSize={50} offset={items.length - restItems.length} />
      <div id="rank-explainer" class="rank-explainer" data-nosnippet popover role="dialog" aria-labelledby="rank-explainer-h">
        <div class="rank-explainer-head">
          <h2 id="rank-explainer-h">What these numbers mean</h2>
          <button type="button" class="rank-explainer-close" popovertarget="rank-explainer" popovertargetaction="hide" aria-label="Close">×</button>
        </div>
        <p><strong>Interest score</strong> combines Wikipedia interest, DistroWatch rankings, GitHub stars and views on this site. Higher means more interest, not more installs or better quality. <a href="/about/#ranking">How it works</a>.</p>
        <p><strong>Arrows</strong> compare the last-month ranking with the 12-month ranking. “– 0” means the position matches in both.</p>
      </div>
    </section>

    <aside class="side" aria-label="Highlights">
      {rising.length > 0 && (
        <section>
          <h2>Climbing fastest</h2>
          <ul>
            {rising.slice(0, 5).map((d) => (
              <li>
                <a class="with-mark" href={`/distro/${d.slug}/`}><DistroMark slug={d.slug} name={d.name} /><span>{d.name}</span></a>
                <span class="from">#{d.rank} → #{d.rank1m}</span>
                <b>+{d.rank1mDelta}</b>
              </li>
            ))}
          </ul>
          <p><a href="/rising/">All risers</a></p>
        </section>
      )}
      <section>
        <h2>Not sure where to start?</h2>
        <p>Three plain questions, one starting point, and what to check next.</p>
        <a class="cta" href="/pick/">Find my distro</a>
        <p class="side-more">Or browse <a href="/best/">the best distros by use</a>: gaming, old laptops, developers and more.</p>
      </section>
      <SponsorCard />
      {share && (
        <section class="side-share">
          <h2>Desktop share</h2>
          <div class="share-big">{share.value.toFixed(2)}%</div>
          <p>Linux on desktops worldwide, {share.label} (StatCounter).</p>
          <ShareChart series={linuxYearlySeries(marketShare)} />
          <p class="sc-note">Yearly average. Single months jump around, so the line shows the trend.</p>
          <p><a href="/desktop-share/">Compare with Windows and macOS</a></p>
        </section>
      )}
      <SwitchSide />
    </aside>
  </div>
</Base>
