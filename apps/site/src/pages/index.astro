---
import SwitchSide from "../components/SwitchSide.astro";
import Base from "../layouts/Base.astro";
import { ListView } from "../components/ListView";
import { Podium } from "../components/Podium";
import { SponsorCard } from "../components/SponsorCard";
import { loadDistros, loadMarketShare, loadMeta, loadRising, dataDate } from "../lib/data";
import { buildHeadline } from "../lib/headline";
import { RANK_SOURCE, RANK_VALUE_LABEL } from "@linux-statistics/shared";
import { latestLinuxShare, linuxYearlySeries } from "../lib/marketShare";
import { ShareChart } from "../components/ShareChart";

const [items, marketShare, meta, rising] = await Promise.all([loadDistros(), loadMarketShare(), loadMeta(), loadRising()]);
const asOf = dataDate(meta, "wikipedia");
const site = Astro.site!.href.replace(/\/$/, "");
const headline = buildHeadline(items);
const share = latestLinuxShare(marketShare);
const restItems = items.filter((d) => d.rank === null || d.rank > 3);

const title = headline
  ? `${headline.leader} is #1. Linux distro rankings | LinuxStatistics`
  : "Linux distro rankings and statistics | LinuxStatistics";
const description = `Rankings for ${items.length} Linux distributions: popularity, last month's movers, desktop market share, GitHub activity and community ratings, plus a quiz to pick one.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Linux distribution rankings",
  description,
  url: `${site}/`,
  ...(asOf ? { dateModified: asOf } : {}),
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  isBasedOn: [
    "https://en.wikipedia.org/",
    "https://distrowatch.com/dwres.php?resource=popularity",
    "https://gs.statcounter.com/os-market-share/desktop/worldwide",
    "https://github.com/",
  ],
  creator: { "@type": "Organization", name: "LinuxStatistics", url: `${site}/` },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="mast">
    {headline ? (
      <h1>
        {headline.leader} holds <em>#1</em>.
        {headline.mover && <span class="sub"><b>{headline.mover.name}</b> {headline.mover.text}</span>}
      </h1>
    ) : (
      <h1>Linux distro rankings</h1>
    )}
  </div>

  <div class="home">
    <section aria-label="Rankings">
      <Podium items={items} />
      <div class="sec"><h2>The rest of the chart</h2><span class="sec-sub">{RANK_VALUE_LABEL[RANK_SOURCE].toLowerCase()}, last 12 months<button type="button" class="rank-explainer-btn" popovertarget="rank-explainer" aria-label="What do these numbers mean?" title="What do these numbers mean?"></button></span></div>
      <ListView client:load items={restItems} maxHits={Math.max(1, ...items.map((d) => d.hitsPerDay ?? 0))} firstPage={47} pageSize={50} offset={items.length - restItems.length} />
      <div id="rank-explainer" class="rank-explainer" popover role="dialog" aria-labelledby="rank-explainer-h">
        <div class="rank-explainer-head">
          <h2 id="rank-explainer-h">What these numbers mean</h2>
          <button type="button" class="rank-explainer-close" popovertarget="rank-explainer" popovertargetaction="hide" aria-label="Close">×</button>
        </div>
        <p><strong>Interest score</strong> combines Wikipedia interest, DistroWatch rankings, GitHub stars and views on this site. Higher means more interest, not more installs or better quality. <a href="/about/#ranking">How it works</a>.</p>
        <p><strong>Arrows</strong> compare the last-month ranking with the 12-month ranking. “– 0” means the position matches in both.</p>
      </div>
    </section>

    <aside class="side" aria-label="Highlights">
      {rising.length > 0 && (
        <section>
          <h2>Climbing fastest</h2>
          <ul>
            {rising.slice(0, 5).map((d) => (
              <li>
                <a href={`/distro/${d.slug}/`}>{d.name}</a>
                <span class="from">#{d.rank} → #{d.rank1m}</span>
                <b>+{d.rank1mDelta}</b>
              </li>
            ))}
          </ul>
          <p><a href="/rising/">All risers</a></p>
        </section>
      )}
      {share && (
        <section class="side-share">
          <h2>Desktop share</h2>
          <div class="share-big">{share.value.toFixed(2)}%</div>
          <p>Linux on desktops worldwide, {share.label} (StatCounter).</p>
          <ShareChart series={linuxYearlySeries(marketShare)} />
          <p class="sc-note">Yearly average. Single months jump around, so the line shows the trend.</p>
          <p><a href="/desktop-share/">Compare with Windows and macOS</a></p>
        </section>
      )}
      <SponsorCard />
      <section>
        <h2>Not sure where to start?</h2>
        <p>Three plain questions, one starting point, and what to check next.</p>
        <a class="cta" href="/pick/">Find my distro</a>
      </section>
      <SwitchSide />
    </aside>
  </div>
</Base>
