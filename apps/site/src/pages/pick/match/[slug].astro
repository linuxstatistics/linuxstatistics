---
import Base from "../../../layouts/Base.astro";
import PickRestore from "../../../components/PickRestore.astro";
import { DistroPicker } from "../../../components/DistroPicker";
import { loadDistros } from "../../../lib/data";
import { PROFILES } from "../../../lib/picker-profiles";
import { compareSlug, popularPairs } from "../../../lib/compare";

export async function getStaticPaths() {
  const list = await loadDistros();
  const bySlug = new Map(list.map((d) => [d.slug, d]));
  return PROFILES.filter((p) => bySlug.has(p.key)).map((p) => ({ params: { slug: p.key }, props: { name: bySlug.get(p.key)!.name, blurb: p.blurb } }));
}

const { slug } = Astro.params;
const { name, blurb } = Astro.props as { name: string; blurb: string };
const list = await loadDistros();
const keys = new Set(PROFILES.map((p) => p.key));
const distros = list.filter((d) => keys.has(d.slug)).map((d) => ({ slug: d.slug, name: d.name, rank: d.rank, rankTrend: d.rankTrend }));
const staticPairs = popularPairs(list).map(([a, b]) => compareSlug(a, b));
const image = new URL(`/pick/match/${slug}.png`, Astro.site).href;
---

<Base
  title={`Matched with ${name}: which Linux distro should I use? | LinuxStatistics`}
  description={`Someone took the LinuxStatistics distro quiz and matched with ${name}. ${blurb} Take the quiz to find yours.`}
  image={image}
  noindex
>
  <div class="page">
    <h1>Matched with {name}</h1>
    <p class="lede">These are someone's quiz results. <a href="/pick/">Take the quiz yourself</a> to get your own.</p>
    <PickRestore />
    <DistroPicker client:load distros={distros} staticPairs={staticPairs} />
  </div>
</Base>
