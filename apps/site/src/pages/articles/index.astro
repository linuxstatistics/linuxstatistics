---
import Base from "../../layouts/Base.astro";
import ArticleSide from "../../components/ArticleSide.astro";
import ArticleList from "../../components/ArticleList.astro";
import { loadArticles } from "../../lib/article-entries";
import { articleIndex } from "../../lib/articles";
import { topicBySlug, TYPE_LABEL } from "../../lib/article-topics";
import { fmtArticleDate } from "../../lib/articles";

const list = (await loadArticles()).map((a) => a.card);
const { latest, sections, jump } = articleIndex(list);
const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "LinuxStatistics articles",
  url: `${site}/articles/`,
  blogPost: list.filter((a) => !a.draft).map((a) => ({ "@type": "BlogPosting", headline: a.title, url: `${site}/articles/${a.slug}/`, datePublished: a.published.toISOString().slice(0, 10) })),
};
---

<Base title="Articles: Linux distro data and analysis | LinuxStatistics" description="Notes and analysis built on our own numbers: how we rank distros, what's growing and what people leaving Windows pick." jsonLd={jsonLd} feed={{ href: "/articles/feed.xml", title: "LinuxStatistics articles" }}>
  <div class="page articles-page">
    <div class="with-side">
    <div class="with-side-main">
    <p class="stats-eyebrow">Articles</p>
    <h1>Notes and analysis</h1>
    <p class="lede">Written from our own numbers: how we rank distros, what's growing and what people leaving Windows pick.</p>
    {list.length === 0 ? (
      <div class="articles-empty">No articles yet. The first one is on its way. <a href="/articles/feed.xml">Follow the feed</a> to hear when it's out.</div>
    ) : (
      <>
        {jump.length > 1 && (
          <nav class="articles-jump" aria-label="Topics">
            {jump.map((t) => <a href={`#${t}`}>{topicBySlug(t)!.name}</a>)}
          </nav>
        )}
        {latest.length > 0 && (
          <section class="articles-latest" aria-labelledby="latest-h">
            <h2 id="latest-h">Latest</h2>
            <ul>
              {latest.map((a) => (
                <li>
                  <p class="article-meta"><span class="article-type">{TYPE_LABEL[a.type]}</span><span>{topicBySlug(a.topic)!.name}</span><time datetime={a.published.toISOString().slice(0, 10)}>{fmtArticleDate(a.published)}</time>{a.draft && <span class="article-draft-tag">Draft</span>}</p>
                  <h3><a href={`/articles/${a.slug}/`}>{a.title}</a></h3>
                </li>
              ))}
            </ul>
          </section>
        )}
        {sections.map(({ topic, live, articles, more }) => {
          const t = topicBySlug(topic)!;
          return (
            <section class="articles-topic" id={topic} aria-labelledby={`${topic}-h`}>
              <h2 id={`${topic}-h`}>{live ? <a href={`/articles/${topic}/`}>{t.name}</a> : t.name}</h2>
              <ArticleList articles={articles} level={3} />
              {live && <p class="articles-topic-more"><a href={`/articles/${topic}/`}>{more > 0 ? `All ${t.name.toLowerCase()} articles (${more} more)` : `All ${t.name.toLowerCase()} articles`}</a></p>}
            </section>
          );
        })}
      </>
    )}
    </div>
      <ArticleSide />
    </div>
  </div>
</Base>
