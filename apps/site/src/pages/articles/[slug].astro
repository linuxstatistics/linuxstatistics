---
import ArticleView from "../../components/articles/ArticleView.astro";
import HubView from "../../components/articles/HubView.astro";
import { loadArticles } from "../../lib/article-entries";
import { ARTICLE_TOPICS } from "../../lib/article-topics";

// One route for /articles/<slug>/: a topic hub or an article. Slugs never collide (tested).
export async function getStaticPaths() {
  const all = await loadArticles();
  const cards = all.map((x) => x.card);
  return [
    ...ARTICLE_TOPICS.map((t) => ({ params: { slug: t.slug }, props: { kind: "hub" as const, topic: t, cards } })),
    ...all.map((a) => ({ params: { slug: a.card.slug }, props: { kind: "article" as const, entry: a.entry, card: a.card, cards } })),
  ];
}

const p = Astro.props;
---

{p.kind === "hub" ? <HubView topic={p.topic} cards={p.cards} /> : <ArticleView entry={p.entry} card={p.card} cards={p.cards} />}
