---
import Base from "../../layouts/Base.astro";
import RankCredit from "../../components/RankCredit.astro";
import { FAMILY_LABELS } from "../../lib/families";
import { loadDistro, loadDistros, loadMeta, mapLimit, dataDate } from "../../lib/data";
import { compareSlug, popularPairs } from "../../lib/compare";
import { formatRating } from "../../lib/rating";
import { compareSuggestions } from "../../lib/related";
import { ComparePicker } from "../../components/ComparePicker";
import { PairVerdict } from "../../components/PairVerdict";
import { NotEnoughData, ProsConsPair } from "../../components/ProsCons";
import { Faq } from "../../components/Faq";
import { EthicalAd } from "../../components/EthicalAd";
import { notesFor } from "../../lib/distro-notes";
import { TELEMETRY_LABEL, telemetryFor } from "../../lib/telemetry";
import { releaseStats } from "../../components/DistroStats";
import { pairVerdict } from "../../lib/verdict";
import { faqJsonLd, pairFaq } from "../../lib/faq";
import { RANK_SOURCE, RANK_VALUE_LABEL, type DistroDetail } from "@linux-statistics/shared";

export async function getStaticPaths() {
  const list = await loadDistros();
  const pairs = popularPairs(list);
  const keys = [...new Set(pairs.flat())];
  const details = new Map((await mapLimit(keys, 8, loadDistro)).map((d) => [d.slug, d]));
  return pairs.map(([a, b]) => ({
    params: { pair: compareSlug(a, b) },
    props: { a: details.get(a)!, b: details.get(b)! },
  }));
}

const { a, b } = Astro.props as { a: DistroDetail; b: DistroDetail };
const meta = await loadMeta();
const list = await loadDistros();
const nameOf = new Map(list.map((d) => [d.slug, d.name]));
const staticPairs = new Set(popularPairs(list).map(([x, y]) => compareSlug(x, y)));
const thisPair = compareSlug(a.slug, b.slug);
// Related pairs: each side against its other likely rivals, minus this page.
const related = [...compareSuggestions(list, a, staticPairs, 5), ...compareSuggestions(list, b, staticPairs, 5)]
  .filter((l) => !l.href.includes(thisPair))
  .filter((l, i, all) => all.findIndex((x) => x.href === l.href) === i)
  .slice(0, 8);
const options = list
  .sort((x, y) => x.name.localeCompare(y.name))
  .map((d) => ({ slug: d.slug, name: d.name, rank: d.rank }));
const asOf = dataDate(meta, "wikipedia");

type Row = { label: string; a: string; b: string; better?: "a" | "b"; split?: number };
const num = (v: number | null) => (v == null ? "-" : v.toLocaleString("en-US"));
// Lower rank is better; higher is better for the rest.
function pick(x: number | null, y: number | null, lowerIsBetter = false): "a" | "b" | undefined {
  if (x == null || y == null || x === y) return undefined;
  return (lowerIsBetter ? x < y : x > y) ? "a" : "b";
}
const rating = (d: DistroDetail) => formatRating(d.userRating);
const tm = (slug: string) => {
  const t = telemetryFor(slug);
  return t ? TELEMETRY_LABEL[t.level] : "-";
};

/** Share of A in a head-to-head bar (0-1). Ranks count inversely: #1 vs #4 is 80/20. */
function split(x: number | null, y: number | null, lowerIsBetter = false): number | undefined {
  if (x == null || y == null || x <= 0 || y <= 0) return undefined;
  const [px, py] = lowerIsBetter ? [1 / x, 1 / y] : [x, y];
  return px / (px + py);
}

const rel = (d: DistroDetail, label: string) => releaseStats(d).find((r) => r[0] === label)?.[1] ?? "-";

const rows: Row[] = [
  { label: "Popularity rank (12 months)", a: num(a.rank), b: num(b.rank), better: pick(a.rank, b.rank, true), split: split(a.rank, b.rank, true) },
  { label: "Rank last month", a: num(a.rank1m), b: num(b.rank1m), better: pick(a.rank1m, b.rank1m, true), split: split(a.rank1m, b.rank1m, true) },
  { label: RANK_VALUE_LABEL[RANK_SOURCE], a: num(a.hitsPerDay), b: num(b.hitsPerDay), better: pick(a.hitsPerDay, b.hitsPerDay), split: split(a.hitsPerDay, b.hitsPerDay) },
  { label: "Family", a: FAMILY_LABELS[a.family], b: FAMILY_LABELS[b.family] },
  { label: "Based on", a: a.basedOnSlug ? (nameOf.get(a.basedOnSlug) ?? a.basedOnSlug) : "-", b: b.basedOnSlug ? (nameOf.get(b.basedOnSlug) ?? b.basedOnSlug) : "-" },
  { label: "First released", a: a.firstReleaseYear?.toString() ?? "-", b: b.firstReleaseYear?.toString() ?? "-" },
  { label: "Latest release", a: rel(a, "Latest release"), b: rel(b, "Latest release") },
  { label: "Supported until", a: rel(a, "Supported until"), b: rel(b, "Supported until") },
  { label: "GitHub stars", a: num(a.stars), b: num(b.stars), better: pick(a.stars, b.stars), split: split(a.stars, b.stars) },
  { label: "Commits, last 30 days", a: num(a.commitsLast30d), b: num(b.commitsLast30d), better: pick(a.commitsLast30d, b.commitsLast30d), split: split(a.commitsLast30d, b.commitsLast30d) },
  { label: "Telemetry (OS default)", a: tm(a.slug), b: tm(b.slug) },
  { label: "Community rating", a: rating(a), b: rating(b) },
  { label: "Users who use it", a: num(a.usesItCount || null), b: num(b.usesItCount || null), better: pick(a.usesItCount, b.usesItCount) },
].filter((r) => r.a !== "-" || r.b !== "-");

const verdict = pairVerdict(a, b, nameOf);
/** Distros missing most optional facts (repo, release year, profile notes, ratings). */
const thin = [a, b]
  .filter((d) => [d.firstReleaseYear, d.stars, d.commitsLast30d, d.basedOnSlug, notesFor(d.slug), d.userRating.count || null].filter((v) => v != null).length <= 1)
  .map((d) => d.name);
const na = notesFor(a.slug);
const nb = notesFor(b.slug);
const faq = pairFaq(a, b);
const jsonLd = faq.length > 0 ? faqJsonLd(faq) : undefined;
const title = `${a.name} vs ${b.name}: Linux distro comparison | LinuxStatistics`;
const lead =
  a.rank != null && b.rank != null
    ? `${a.rank < b.rank ? a.name : b.name} draws more interest (#${Math.min(a.rank, b.rank)} vs #${Math.max(a.rank, b.rank)}).`
    : "";
const description = `${a.name} vs ${b.name}: who each suits, pros and cons, popularity, family, GitHub activity and community ratings side by side. ${lead}`.trim();
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/compare/">Compare</a> / {a.name} vs {b.name}</nav>
    <h1>{a.name} vs {b.name}</h1>
    {lead && <p class="lede">{lead}</p>}
    <PairVerdict v={verdict ?? { a: { name: a.name, reasons: [], empty: "unknown" }, b: { name: b.name, reasons: [], empty: "unknown" } }} />
    {thin.length > 0 && (
      <p class="no-data-note" role="note">
        <span class="no-data-label">Limited data</span>
        {thin.join(" and ")} {thin.length > 1 ? "have" : "has"} little data beyond popularity, so some rows below are empty.
        <a href="/suggest/?kind=correction">Help fill it in</a>.
      </p>
    )}
    <div class="table-scroll">
      <table class="data-table compare-table">
        <thead>
          <tr>
            <th></th>
            {[a, b].map((d, i) => (
              <th>
                <i class={`h2h-key ${i === 0 ? "h2h-a" : "h2h-b"}`} aria-hidden="true" />
                <a href={`/distro/${d.slug}/`}>{d.name}</a>
                <span class="th-sub">{d.rank != null ? `#${d.rank} · ` : ""}{FAMILY_LABELS[d.family]}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">
                {r.label}
                {r.split != null && (
                  <span class="h2h" aria-hidden="true"><i class="h2h-a" style={`width:${(r.split * 100).toFixed(0)}%`} /><i class="h2h-b" /></span>
                )}
              </th>
              <td class={r.better === "a" ? "better" : undefined}>{r.a}</td>
              <td class={r.better === "b" ? "better" : undefined}>{r.b}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {(na || nb) ? (
      <ProsConsPair a={{ name: a.name, notes: na }} b={{ name: b.name, notes: nb }} />
    ) : (
      <section class="pros-cons pair" aria-label="Pros and cons">
        <h2>Pros and cons</h2>
        <div class="pc-pair">
          <div><h3 class="pc-name">{a.name}</h3><NotEnoughData name={a.name} /></div>
          <div><h3 class="pc-name">{b.name}</h3><NotEnoughData name={b.name} /></div>
        </div>
      </section>
    )}
    <Faq items={faq} />
    <EthicalAd placement="compare" />
    <p class="source-note">
      <RankCredit asOf={asOf} />
      Repository activity from GitHub. Ratings come from signed-in LinuxStatistics users.
      "Pick if", pros and cons are LinuxStatistics editorial notes based on each project's own documentation.
      {(a.releases.length > 0 || b.releases.length > 0) && <Fragment>{" "}Release dates and support from <a href="https://endoflife.date/" target="_blank" rel="noopener noreferrer">endoflife.date</a> (CC BY-SA 4.0).</Fragment>}
    </p>
    {related.length > 0 && (
      <section>
        <h2>Related comparisons</h2>
        <ul class="pair-list">
          {related.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </section>
    )}
    <h2>Compare other distros</h2>
    <ComparePicker client:visible options={options} staticPairs={[...staticPairs]} initialA={a.slug} />
  </div>
</Base>
