---
import Base from "../../layouts/Base.astro";
import { ComparePicker } from "../../components/ComparePicker";
import { SponsorCard } from "../../components/SponsorCard";
import SwitchSide from "../../components/SwitchSide.astro";
import { CompareAny } from "../../components/CompareAny";
import { loadDistros } from "../../lib/data";
import { LIST_PATH, topSearchItems } from "../../lib/distro-list";
import { compareSlug, featuredPairs, popularPairs } from "../../lib/compare";

const list = await loadDistros();
const names = new Map(list.map((d) => [d.slug, d.name]));
// Every prerendered pair is reachable from the picker; only the common beginner questions are listed.
const staticPairs = popularPairs(list);
const pairs = featuredPairs(list);
// Picker choices: the top distros in the HTML; the full list loads on first focus.
const options = topSearchItems(list, 10);
---

<Base
  title="Compare Linux distros side by side | LinuxStatistics"
  description="Compare any two Linux distributions: who each suits, popularity, family, GitHub activity and community ratings."
>
  <div class="page">
    <div class="with-side">
    <div class="with-side-main">
    <h1>Compare Linux distros</h1>
    <p class="lede">Pick two distros to see their rankings, family, activity and ratings side by side.</p>
    <ComparePicker client:load options={options} src={LIST_PATH} staticPairs={staticPairs.map(([a, b]) => compareSlug(a, b))} />
    <CompareAny client:only="react" src={LIST_PATH} />
    <h2>Popular comparisons</h2>
    <ul class="pair-list">
      {pairs.map(([a, b]) => (
        <li><a href={`/compare/${compareSlug(a, b)}/`}>{names.get(a)} vs {names.get(b)}</a></li>
      ))}
    </ul>
    </div>
    <aside class="side" aria-label="More">
      <SponsorCard context="people comparing Linux distros" />
      <section>
        <h2>Still deciding?</h2>
        <p>Three plain questions, one starting point, and what to check next.</p>
        <a class="cta" href="/pick/">Find my distro</a>
      </section>
      <SwitchSide />
    </aside>
    </div>
  </div>
</Base>
