---
import Base from "../../layouts/Base.astro";
import { CONTACT } from "../../config/site";
import { sponsor } from "../../config/sponsor";
import { affiliateProviders } from "../../config/affiliate";
import { loadDistros } from "../../lib/data";
import { mediaKit } from "../../config/media-kit";

const count = (await loadDistros()).length;
const fmt = (n: number) => n.toLocaleString("en-US");
const { offer } = mediaKit;
const hasFigures = mediaKit.period != null && (mediaKit.monthlyVisitors != null || mediaKit.monthlyPageViews != null);
---

<Base
  title="Sponsor LinuxStatistics"
  description="Reach people choosing their next Linux distribution. One clearly labelled sponsor slot on every page; rankings and editorial notes are never for sale."
>
  <article class="page prose legal">
    <h1>Sponsors</h1>
    <p class="lede">Reach people at the moment they're choosing a Linux distribution: switching from Windows, picking a gaming setup or comparing two options.</p>

    <h2>Current sponsor</h2>
    {sponsor ? (
      <p>
        <a href={sponsor.href} target="_blank" rel="sponsored nofollow noopener">{sponsor.name}</a>: {sponsor.tagline}
      </p>
    ) : (
      <p>The sponsor slot is open. Thanks for considering it.</p>
    )}

    <h2>What sponsors get</h2>
    <ul>
      <li>A sponsor card in the sidebar of the home page, the rising chart, the picker and every distro page, plus the footer slot on every page: logo, name, one line and a link. One sponsor at a time, so it isn't lost among others.</li>
      <li>Placement across {count} distro pages, comparisons, the rising chart and the picker.</li>
      <li>A mention in the monthly State of Linux Distros email.</li>
    </ul>

    <h2>Founding sponsor offer</h2>
    <ul>
      <li><strong>Price:</strong> ${offer.priceUsdPerMonth.from}–{offer.priceUsdPerMonth.to} a month, flat, invoiced monthly. The rate depends on term length and traffic at the time; we'll quote a number.</li>
      <li><strong>Term:</strong> {offer.minimumMonths}-month minimum, then month to month. The card switches off automatically when the term ends unless renewed.</li>
      <li><strong>Exclusivity:</strong> {offer.slots === 1 ? "one sponsor at a time, site-wide" : `${offer.slots} sponsors at a time`}.</li>
      <li><strong>Creative:</strong> logo (SVG or PNG), name, one line of up to 60 characters, a link. We set it live within two working days.</li>
      <li><strong>Reporting:</strong> page views across your term, on request.</li>
    </ul>

    <h2>Audience and reach</h2>
    {hasFigures ? (
      <dl class="footer-facts">
        {mediaKit.monthlyVisitors != null && <div><dt>Visitors / month</dt><dd>{fmt(mediaKit.monthlyVisitors)}</dd></div>}
        {mediaKit.monthlyPageViews != null && <div><dt>Page views / month</dt><dd>{fmt(mediaKit.monthlyPageViews)}</dd></div>}
        {mediaKit.subscribers != null && <div><dt>Email subscribers</dt><dd>{fmt(mediaKit.subscribers)}</dd></div>}
        <div><dt>Figures from</dt><dd>{mediaKit.period}</dd></div>
      </dl>
    ) : (
      <p>The site is new; we publish visitor and page-view figures here as soon as we have a full month, and send current numbers on request.</p>
    )}
    <p>
      Who visits: people choosing or switching Linux distributions, often from Windows or macOS; developers comparing server and desktop options;
      people picking a gaming setup. Pages are built for search, so most visitors arrive with a specific question ("Fedora vs Ubuntu", "which distro for an old laptop").
      {mediaKit.topCountries.length > 0 && ` Top countries: ${mediaKit.topCountries.join(", ")}.`}
    </p>

    <h2>Good fits</h2>
    <p>Hosting and VPS providers, Linux hardware makers, developer tools, backup and privacy services, training and courses. We don't accept gambling, crypto token promotions, malware-adjacent tools or anything misleading.</p>

    <h2>What sponsorship doesn't buy</h2>
    <ul>
      <li>Rankings, scores, "Pick if" notes, pros and cons or telemetry details. These stay independent.</li>
      <li>Reviews of your product or distro written by us.</li>
      <li>Unlabelled placements. Sponsor content is always marked "Sponsor".</li>
    </ul>

    {affiliateProviders.length > 0 && (
      <>
        <h2>Affiliate links</h2>
        <p>Some distro pages have a labelled "Try Linux in the cloud" box with affiliate links to server providers. We may earn a commission if you sign up. These partners don't influence rankings either.</p>
      </>
    )}

    <h2>Brand assets</h2>
    <p>Logos, colours and boilerplate for mentioning us are in the <a href="/press/">press kit</a>; sponsors may use them in their own announcements.</p>

    <h2>Get in touch</h2>
    <p>Email <a href={`mailto:${CONTACT.sponsor}`}>{CONTACT.sponsor}</a> with your company, what you'd like to promote and for how long. We'll send traffic figures and rates.</p>
  </article>
</Base>
