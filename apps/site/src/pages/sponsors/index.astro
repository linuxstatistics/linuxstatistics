---
import Base from "../../layouts/Base.astro";
import { CONTACT } from "../../config/site";
import { sponsors } from "../../config/sponsor";
import { affiliateProviders } from "../../config/affiliate";
import { mediaKit, type SponsorTierInfo } from "../../config/media-kit";
import { SponsorCard } from "../../components/SponsorCard";

const fmt = (n: number) => n.toLocaleString("en-US");
const { offer } = mediaKit;
const [headline, ...others] = offer.tiers as SponsorTierInfo[];

/** Status pill text and tone for a tier. */
function status(t: SponsorTierInfo): { text: string; tone: "open" | "later" | "taken" } {
  const opensAt = t.opensAtMonthlyVisitors;
  if (opensAt != null && (mediaKit.monthlyVisitors ?? 0) < opensAt) return { text: "Opening later", tone: "later" };
  if (t.id === "supporter") {
    const n = sponsors.supporters.length;
    if (n >= t.slots) return { text: "Full", tone: "taken" };
    return { text: n ? `${t.slots - n} of ${t.slots} open` : "Available", tone: "open" };
  }
  const booked = t.id === "headline" ? sponsors.headline : sponsors.guide;
  return booked ? { text: "Taken", tone: "taken" } : { text: "Available", tone: "open" };
}
const slotsText = (t: SponsorTierInfo) => (t.slots === 1 ? "One sponsor at a time" : `Up to ${t.slots} sponsors`);
const hasFigures = mediaKit.period != null && (mediaKit.monthlyVisitors != null || mediaKit.monthlyPageViews != null);
const mail = `mailto:${CONTACT.sponsor}?subject=${encodeURIComponent("Sponsoring LinuxStatistics")}`;
---

<Base
  title="Sponsor LinuxStatistics"
  description="Reach people choosing their next Linux distribution. Clearly labelled sponsor placements; rankings and editorial notes are never for sale."
>
  <div class="page">
  <div class="with-side">
  <article class="with-side-main prose legal sponsors-page">
    <h1>Sponsors</h1>
    <p class="lede">Reach people at the moment they're choosing a Linux distribution: switching from Windows, picking a gaming setup or comparing two options.</p>

    <h2>Ways to sponsor</h2>
    <div class="tiers">
      {[headline!, ...others].map((t) => {
        const s = status(t);
        return (
          <section class:list={["tier", { "tier-main": t.id === "headline" }]} aria-labelledby={`tier-${t.id}`}>
            <div class="tier-head">
              <h3 id={`tier-${t.id}`}>{t.name}</h3>
              <span class={`tier-status tier-status-${s.tone}`}>{s.text}</span>
            </div>
            <p class="tier-summary">{t.summary} <span class="tier-slots">{slotsText(t)}.</span></p>
            <ul class="tier-includes">
              {t.includes.map((i) => <li>{i}</li>)}
            </ul>
            {s.tone === "later" && t.opensAtMonthlyVisitors != null && (
              <p class="tier-note">On sale once the site reaches about {fmt(t.opensAtMonthlyVisitors)} visitors a month. Ask and we'll tell you when it opens.</p>
            )}
          </section>
        );
      })}
    </div>
    <p class="tiers-cta">
      <a class="cta" href={mail}>Email for rates</a>
      <span>We reply with current traffic figures and a quote, usually within two working days. Ask about combining tiers.</span>
    </p>

    <h2>How it works</h2>
    <ul>
      <li>{offer.minimumMonths}-month minimum, then month to month. Placements switch off by themselves when a term ends unless renewed.</li>
      <li>Send a logo (SVG or PNG), your name, one line of up to 60 characters and a link. Supporters need only a logo and link. We set it live within two working days.</li>
      <li>Page views for your placement across your term, on request.</li>
    </ul>

    <h2>Audience and reach</h2>
    {hasFigures ? (
      <dl class="footer-facts">
        {mediaKit.monthlyVisitors != null && <div><dt>Visitors / month</dt><dd>{fmt(mediaKit.monthlyVisitors)}</dd></div>}
        {mediaKit.monthlyPageViews != null && <div><dt>Page views / month</dt><dd>{fmt(mediaKit.monthlyPageViews)}</dd></div>}
        {mediaKit.subscribers != null && <div><dt>Email subscribers</dt><dd>{fmt(mediaKit.subscribers)}</dd></div>}
        <div><dt>Figures from</dt><dd>{mediaKit.period}</dd></div>
      </dl>
    ) : (
      <p>The site is new; we publish visitor and page-view figures here as soon as we have a full month, and send current numbers on request.</p>
    )}
    <p>
      Who visits: people choosing or switching Linux distributions, often from Windows or macOS; developers comparing server and desktop options;
      people picking a gaming setup. Pages are built for search, so most visitors arrive with a specific question ("Fedora vs Ubuntu", "which distro for an old laptop").
      {mediaKit.topCountries.length > 0 && ` Top countries: ${mediaKit.topCountries.join(", ")}.`}
    </p>

    <h2>Good fits</h2>
    <p>Hosting and VPS providers, Linux hardware makers, developer tools, backup and privacy services, training and courses. We don't accept gambling, crypto token promotions, malware-adjacent tools or anything misleading.</p>

    <h2>What sponsorship doesn't buy</h2>
    <ul>
      <li>Rankings, scores, "Pick if" notes, pros and cons or telemetry details. These stay independent.</li>
      <li>Reviews of your product or distro written by us.</li>
      <li>Unlabelled placements. Sponsor content is always marked "Sponsor".</li>
    </ul>

    {affiliateProviders.length > 0 && (
      <>
        <h2>Affiliate links</h2>
        <p>Some distro pages have a labelled "Try Linux in the cloud" box with affiliate links to server providers. We may earn a commission if you sign up. These partners don't influence rankings either.</p>
      </>
    )}

    <h2>Brand assets</h2>
    <p>Logos, colours and boilerplate for mentioning us are in the <a href="/press/">press kit</a>; sponsors may use them in their own announcements.</p>

    <h2>Get in touch</h2>
    <p>Email <a href={`mailto:${CONTACT.sponsor}`}>{CONTACT.sponsor}</a> with your company, the tier you're interested in and when you'd like to start. We'll send traffic figures and rates.</p>
  </article>
  <aside class="side sponsors-side" aria-label="Sponsors on this site">
    <SponsorCard context="people choosing a Linux distro" contactHref={mail} />
    <section aria-labelledby="supported-by-h">
      <h2 id="supported-by-h">Supported by</h2>
      {sponsors.supporters.length > 0 ? (
        <ul class="supporter-logos">
          {sponsors.supporters.map((s) => (
            <li>
              <a href={s.href} target="_blank" aria-describedby="new-tab-description" title={`${s.name} (opens in a new tab)`} rel="sponsored nofollow noopener">
                <img src={s.logoUrl} alt={s.name} />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p>No supporters yet. Your logo could be the first one here and in the footer of every page.</p>
      )}
    </section>
    <section aria-labelledby="sponsor-contact-h">
      <h2 id="sponsor-contact-h">Talk to us</h2>
      <p>Tell us what you'd like to promote and when. We reply with current traffic and a quote.</p>
      <p><a href={mail}>{CONTACT.sponsor}</a></p>
    </section>
  </aside>
  </div>
  </div>
</Base>
