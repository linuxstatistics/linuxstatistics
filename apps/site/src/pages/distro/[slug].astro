---
import Base from "../../layouts/Base.astro";
import RankCredit from "../../components/RankCredit.astro";
import { DistroStats } from "../../components/DistroStats";
import { DistroRating } from "../../components/DistroRating";
import { AffiliateBlock } from "../../components/AffiliateBlock";
import { EthicalAd } from "../../components/EthicalAd";
import { RankByPeriod } from "../../components/RankByPeriod";
import { RelatedLinks } from "../../components/RelatedLinks";
import { CompareWith } from "../../components/CompareWith";
import { SponsorCard } from "../../components/SponsorCard";
import { RatingSkeleton } from "../../components/Skeleton";
import { ProsCons } from "../../components/ProsCons";
import { UseFitTabs } from "../../components/UseFitTabs";
import { useFits } from "../../lib/use-fit";
import { TelemetryNote } from "../../components/TelemetryNote";
import { WhoItSuits } from "../../components/PairVerdict";
import { notesFor } from "../../lib/distro-notes";
import { DISTRO_BLURBS } from "../../lib/distro-blurbs";
import { PROFILES } from "../../lib/picker-profiles";
import { reasonsFor } from "../../lib/verdict";
import { compareSlug, popularPairs } from "../../lib/compare";
import { compareSuggestions, neighbours, sameFamily } from "../../lib/related";
import { FAMILY_LABELS } from "../../lib/families";
import { loadDistro, loadDistros, loadMeta, mapLimit, dataDate } from "../../lib/data";
import type { DistroDetail } from "@linux-statistics/shared";

export async function getStaticPaths() {
  const list = await loadDistros();
  const details = await mapLimit(list, 8, (d) => loadDistro(d.slug));
  const basedOn = Object.fromEntries(details.map((d) => [d.slug, d.basedOnSlug]));
  return details.map((data) => ({ params: { slug: data.slug }, props: { data, basedOn } }));
}

const { data, basedOn } = Astro.props as { data: DistroDetail; basedOn: Record<string, string | null> };
const meta = await loadMeta();
const list = await loadDistros();
const baseName = data.basedOnSlug ? (list.find((d) => d.slug === data.basedOnSlug)?.name ?? null) : null;
const staticPairs = new Set(popularPairs(list).map(([a, b]) => compareSlug(a, b)));
const compare = compareSuggestions(list, data, staticPairs);
const family = sameFamily(list, data, new Map(Object.entries(basedOn)));
const near = neighbours(list, data.slug);
const notes = notesFor(data.slug);
const profile = PROFILES.find((p) => p.key === data.slug);
const blurb = DISTRO_BLURBS[data.slug];
const fits = profile ? useFits(profile) : null;
const suits = reasonsFor(data, baseName).slice(0, 4).map((r) => r.text);
const searchItems = list.map((d) => ({ slug: d.slug, name: d.name, rank: d.rank }));
const asOf = dataDate(meta, "wikipedia");
const site = Astro.site!.href.replace(/\/$/, "");
const switchFrom = (["windows", "mac"] as const).filter((f) =>
  PROFILES.find((p) => p.key === data.slug)?.desktops.includes(f === "windows" ? "windows-like" : "mac-like"),
);
const familyName = FAMILY_LABELS[data.family];
const family_label = data.family === "independent" ? "independent" : `${familyName}-family`;

const title = `${data.name}: who it's for, pros, cons and ratings | LinuxStatistics`;
const based = baseName ? `, based on ${baseName}` : "";
const description = `${data.name} (${familyName} family${based}): who it suits, pros and cons, popularity, GitHub activity and community ratings.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: data.name,
  applicationCategory: "OperatingSystem",
  operatingSystem: "Linux",
  url: `${site}/distro/${data.slug}/`,
  ...(data.homepage ? { sameAs: [data.homepage] } : {}),
  ...(data.userRating.average != null && data.userRating.count > 0
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: Number(data.userRating.average.toFixed(2)),
          ratingCount: data.userRating.count,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
};
---

<Base title={title} description={description} jsonLd={jsonLd} feed={data.releases.length > 0 ? { href: `/distro/${data.slug}/feed.xml`, title: `${data.name} releases` } : undefined}>
  <script is:inline define:vars={{ viewSlug: data.slug }}>
    // Count one view of this distro page (no cookies or visitor data). Skips
    // prerender and "Do Not Track"/"Global Privacy Control" browsers.
    try {
      if (!navigator.webdriver && navigator.doNotTrack !== "1" && !navigator.globalPrivacyControl && document.visibilityState !== "prerender") {
        navigator.sendBeacon(`/api/views/${encodeURIComponent(viewSlug)}`);
      }
    } catch {}
  </script>
  <article class="page distro-page">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Rankings</a> / {data.name}</nav>
    <div class="distro-head">
      <div class="distro-head-text">
        <h1>{data.name}</h1>
      </div>
      {(profile || data.homepage || data.repoFullName) && (
        <div class="distro-head-actions">
          {data.homepage && <a class="distro-head-secondary" href={data.homepage} target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">{profile ? "Website" : "Website and downloads"}</a>}
          {data.repoFullName && <a class="distro-head-secondary" href={`https://github.com/${data.repoFullName}`} target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">GitHub</a>}
          {profile && <a class="cta" href={profile.downloadUrl} target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer" aria-label={`Official ${data.name} download`}><span class="label-long">Official download</span><span class="label-short" aria-hidden="true">Download</span></a>}
        </div>
      )}
    </div>
    <div class="distro-grid">
      <div class="distro-main">
        <section class="dsec dsec-overview" aria-label="Overview">
          {(profile?.blurb || blurb || data.description) && (
            <div class="distro-description">
              <h2 class="visually-hidden">About {data.name}</h2>
              {profile?.blurb ? <p>{profile.blurb}</p> : blurb ? <><p>{blurb.text}</p><p class="source-note">LinuxStatistics summary of <a href={blurb.source} target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">the project's own website</a>. <a href={`/suggest/?kind=correction&subject=${data.slug}`}>Suggest a correction</a>.</p></> : data.description && (
                <>
                  <p>{data.description.text.split(/\n\s*\n/).filter(Boolean)[0]}</p>
                  {data.description.text.split(/\n\s*\n/).filter(Boolean).length > 1 && <details><summary>Read the full introduction</summary>{data.description.text.split(/\n\s*\n/).filter(Boolean).slice(1).map((paragraph) => <p>{paragraph}</p>)}</details>}
                  <p class="source-note">From <a href={`https://en.wikipedia.org/w/index.php?title=${encodeURIComponent(data.description.title)}&oldid=${data.description.revisionId}`} target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">Wikipedia contributors</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">CC BY-SA 4.0</a>. Introduction reproduced as plain text; retrieved {data.description.fetchedAt.slice(0, 10)}. <a href={`https://en.wikipedia.org/w/index.php?title=${encodeURIComponent(data.description.title)}&action=history`} target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">Article history</a>.</p>
                </>
              )}
            </div>
          )}
          <DistroStats data={data} baseName={baseName} />
        </section>
        {suits.length > 0 && (
          <section class="dsec">
            <WhoItSuits name={data.name} reasons={suits} />
            {data.quizFit && (
              <p class="quiz-fit-line">
                {Math.round((data.quizFit.up / data.quizFit.total) * 100)}% of {data.quizFit.total} people whose <a href="/pick/">quiz</a> top pick was {data.name} said it fit.
              </p>
            )}
            {switchFrom.length > 0 && (
              <p class="switch-link">
                {switchFrom.map((f, i) => (
                  <>{i > 0 && " · "}<a href={`/switch/${f}/`}>Switching from {f === "windows" ? "Windows" : "a Mac"}? What changes and which apps to use</a></>
                ))}
              </p>
            )}
          </section>
        )}
        {notes && <ProsCons notes={notes} />}
        {fits && <UseFitTabs client:visible name={data.name} fits={fits} />}
        <RankByPeriod periods={data.rankByPeriod} />
        <TelemetryNote slug={data.slug} />
        <section class="dsec" aria-labelledby="rate-h">
          <h2 id="rate-h">Rate {data.name}</h2>
          <DistroRating client:only="react" slug={data.slug}><RatingSkeleton slot="fallback" /></DistroRating>
        </section>
        <AffiliateBlock />
        <EthicalAd placement="distro" />
        <p class="source-note">
          <RankCredit asOf={asOf} noun="Ranking" />{" "}
          {data.repoFullName && <Fragment>Repository activity from <a href={`https://github.com/${data.repoFullName}`} target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">GitHub</a>.{" "}</Fragment>}
          {data.releases.length > 0 && <Fragment>Release dates and support from <a href="https://endoflife.date/" target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">endoflife.date</a> (CC BY-SA 4.0); <a href={`/distro/${data.slug}/feed.xml`}>follow {data.name} releases</a> (Atom feed).{" "}</Fragment>}
          Ratings come from signed-in LinuxStatistics users.
        </p>
      </div>
      <aside class="side" aria-label="Related">
        <SponsorCard />
        <section class="compare-box">
          <h2>Compare {data.name} with…</h2>
          <CompareWith client:visible self={{ slug: data.slug, name: data.name }} items={searchItems} staticPairs={[...staticPairs]} />
        </section>
        <RelatedLinks compare={compare} family={family} familyLabel={family_label} near={near} />
      </aside>
    </div>
  </article>
</Base>
