---
import "../styles.css";
import { HeaderAuth } from "../components/HeaderAuth";
import { FooterEmail } from "../components/FooterEmail";
import { SponsorSlot } from "../components/SponsorSlot";
import { JumpToDistro } from "../components/JumpToDistro";
import { loadDistros } from "../lib/data";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jumpItems = (await loadDistros()).map((d) => ({ slug: d.slug, name: d.name, rank: d.rank }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark light" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="LinuxStatistics" />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="app">
      <header class="app-header">
        <a class="brand" href="/" aria-label="LinuxStatistics home">linux<b>stats</b></a>
        <nav class="site-nav" aria-label="Main">
          <a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Rankings</a>
          <a href="/rising/" aria-current={Astro.url.pathname.startsWith("/rising") ? "page" : undefined}>Rising</a>
          <a href="/compare/" aria-current={Astro.url.pathname.startsWith("/compare") ? "page" : undefined}>Compare</a>
          <a href="/pick/" aria-current={Astro.url.pathname.startsWith("/pick") ? "page" : undefined}>Which distro?</a>
        </nav>
        <div class="header-right">
          <JumpToDistro client:idle items={jumpItems} />
          <HeaderAuth client:idle />
        </div>
      </header>
      <hr class="rule" />
      <main class="app-main">
        <slot />
      </main>
      <footer class="app-footer">
        <div class="footer-bridges">
          <SponsorSlot />
          <FooterEmail client:visible />
        </div>
        <div class="footer-credit">
          Data from <a href="https://distrowatch.com/" rel="noreferrer">DistroWatch</a> page-hit rankings,
          <a href="https://gs.statcounter.com/" rel="noreferrer">StatCounter Global Stats</a> and
          <a href="https://github.com/" rel="noreferrer">GitHub</a>. Page hits measure interest, not installs.
          <a href="https://github.com/linuxstatistics/linuxstatistics" rel="noreferrer">Source code</a> (AGPL-3.0).
        </div>
      </footer>
    </div>
  </body>
</html>
