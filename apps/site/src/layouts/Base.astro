---
import "../styles.css";
// Preload the Latin fonts every page uses first, so text doesn't reflow when they arrive.
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import plexSansLatin from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import { HeaderAuth } from "../components/HeaderAuth";
import { FooterEmail } from "../components/FooterEmail";
import { SponsorSlot } from "../components/SponsorSlot";
import { CommandMenu } from "../components/CommandMenu";
import { compareSlug, popularPairs } from "../lib/compare";
import { PressMenu } from "../components/PressMenu";
import { loadDistros, loadMarketShare, loadMeta, dataDate } from "../lib/data";
import { staleSources } from "../lib/freshness";
import { latestLinuxShare } from "../lib/marketShare";
import { OPERATOR } from "../config/site";
import { CRYPTO_ADDRESSES, SUPPORT_LINKS, hasSupport } from "../config/support";
import { SupportBlock } from "../components/SupportBlock";
import { analytics } from "../config/analytics";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Absolute URL of a 1200×630 share image. */
  image?: string;
}

const { title, description, jsonLd, noindex = false, image: pageImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Every page has a share image: the page's own, else the site card built at /og.png.
const image = pageImage ?? new URL("/og.png", Astro.site).href;
const [allDistros, marketShare, meta] = await Promise.all([loadDistros(), loadMarketShare(), loadMeta()]);
const jumpItems = allDistros.map((d) => ({ slug: d.slug, name: d.name, rank: d.rank }));
const staticPairs = popularPairs(allDistros).map(([a, b]) => compareSlug(a, b));
// Data facts for the footer, shown on every page.
const asOf = dataDate(meta, "wikipedia");
const asOfText = asOf ? new Date(`${asOf}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) : null;
const share = latestLinuxShare(marketShare);
const stale = staleSources(meta);
const year = new Date().getUTCFullYear();

const NAV = [
  { href: "/", label: "Rankings", desc: "Every distro ranked by interest" },
  { href: "/rising/", label: "Rising", desc: "Biggest climbers this month" },
  { href: "/pick/", label: "Which distro?", desc: "Three questions, one starting point" },
  { href: "/switch/", label: "Switch to Linux", desc: "Coming from Windows or a Mac" },
];
const MORE = [
  { href: "/compare/", label: "Compare" },
  { href: "/desktop-share/", label: "Desktop share" },
  { href: "/data/", label: "Open data" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
import { AuthSkeleton } from "../components/Skeleton";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark light" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSansLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply a saved theme before first paint (no flash). "system" = follow the OS.
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        if (localStorage.getItem("ls_auth") === "1") document.documentElement.dataset.auth = "1";
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="LinuxStatistics" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {analytics.enabled && !noindex && (
      <>
        <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
        <script is:inline defer src={analytics.scriptSrc} data-endpoint={analytics.endpoint} />
      </>
    )}
  </head>
  <body>
    <span id="new-tab-description" class="visually-hidden">Opens in a new tab</span>
    <div class="app">
      <PressMenu client:idle />
      <header class="app-header">
        <a class="brand" href="/" aria-label="LinuxStatistics home">
          <svg class="brand-mark" viewBox="0 0 250 250" aria-hidden="true" focusable="false">
            <circle cx="125" cy="125" r="123" class="brand-mark-disc" />
            <path d="M72 60 V190 H192" fill="none" class="brand-mark-axis" stroke-width="20" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="100" y="132" width="22" height="40" rx="4" class="brand-mark-bar" />
            <rect x="133" y="106" width="22" height="66" rx="4" class="brand-mark-bar" />
            <rect x="166" y="74" width="22" height="98" rx="4" class="brand-mark-bar" />
          </svg>
          <span class="brand-text">linux<b>stats</b></span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {NAV.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="header-right">
          <div class="cmdk-slot"><CommandMenu client:idle items={jumpItems} staticPairs={staticPairs} /></div>
          <div class="auth-slot"><HeaderAuth client:only="react"><AuthSkeleton slot="fallback" /></HeaderAuth></div>
          <details class="menu" id="site-menu">
            <summary class="menu-btn" aria-label="Menu">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path class="l1" d="M4 7h16" /><path class="l2" d="M4 12h16" /><path class="l3" d="M4 17h16" /></svg>
              <span>Menu</span>
            </summary>
            <div class="menu-panel">
              <nav aria-label="Main">
                <ul class="menu-main">
                  {NAV.map((n) => (
                    <li>
                      <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
                        <span class="menu-label">{n.label}</span>
                        <span class="menu-desc">{n.desc}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <ul class="menu-more">
                  {MORE.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a></li>)}
                </ul>
              </nav>
            </div>
          </details>
        </div>
      </header>
      <hr class="rule" />
      {stale.length > 0 && (
        <div class="stale-note" role="status">
          <div class="stale-note-inner">Some data is older than usual: {stale.map((x) => `${x.label} from ${x.ago}`).join("; ")}. The next update is on its way.</div>
        </div>
      )}
      <main class="app-main">
        <slot />
      </main>
      <section class="signup-band" aria-label="Monthly report">
        <div class="signup-inner">
          <div class="signup-copy">
            <h2>The State of Linux Distros, monthly</h2>
            <p>Who climbed, who fell and what changed in desktop share. One email a month, no spam.</p>
          </div>
          <FooterEmail client:visible />
        </div>
      </section>
      <footer class="app-footer">
        <div class="footer-cols">
          <div class="footer-about">
            <p class="footer-lede">Every Linux distro, ranked by what people actually look at.</p>
            <dl class="footer-facts">
              <div><dt>Tracked</dt><dd>{allDistros.length}</dd></div>
              {share && <div><dt>Desktop share</dt><dd>{share.value.toFixed(2)}%</dd></div>}
              {asOfText && <div><dt>Scores updated</dt><dd><a href="/about/#ranking">{asOfText}</a></dd></div>}
            </dl>
            <p class="footer-credit">
              The Linux distro chart: our <a href="/about/#ranking">composite index</a> of English Wikipedia article views,
              <a href="https://distrowatch.com/dwres.php?resource=popularity" target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">DistroWatch</a> page hits, GitHub stars and
              views on this site, over the last 12 months, with last month's movers marked. Desktop share from <a href="https://gs.statcounter.com/" target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">StatCounter Global Stats</a>,
              repository activity from <a href="https://github.com/" target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">GitHub</a>, distro facts from
              <a href="https://www.wikidata.org/" target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">Wikidata</a>. All of it measures interest,
              not installs. <a href="/about/">More on sources</a>.
            </p>
          </div>
          <nav class="footer-links" aria-label="Footer">
            <h2>Explore</h2>
            <ul>
              <li><a href="/">Rankings</a></li>
              <li><a href="/rising/">Rising this month</a></li>
              <li><a href="/compare/">Compare distros</a></li>
              <li><a href="/desktop-share/">Desktop share over time</a></li>
              <li><a href="/pick/">Which distro?</a></li>
              <li><a href="/switch/">Switch from Windows or Mac</a></li>
              <li><a href="/suggest/">Suggest a distro or fix</a></li>
            </ul>
          </nav>
          <nav class="footer-links" aria-label="About">
            <h2>About</h2>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/about/ratings/">How scores work</a></li>
              <li><a href="/data/">Open data</a></li>
              <li><a href="/sponsors/">Sponsors</a></li>
              <li><a href="/press/">Press kit</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms and rules</a></li>
              <li><a href="https://github.com/linuxstatistics/linuxstatistics" target="_blank" aria-describedby="new-tab-description" title="Opens in a new tab" rel="noopener noreferrer">Source code (AGPL-3.0)</a></li>
            </ul>
          </nav>
          <div class="footer-sponsor">
            <h2>Sponsor</h2>
            <SponsorSlot />
            {hasSupport && (
              <>
                <h2 class="footer-subhead">Support the site</h2>
                <SupportBlock client:visible links={SUPPORT_LINKS} crypto={CRYPTO_ADDRESSES} />
              </>
            )}
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {year} {OPERATOR.name}. LinuxStatistics code is open source under AGPL-3.0; ranking data belongs to its sources.</p>
          <div class="theme-switch" id="theme-switch" role="radiogroup" aria-label="Theme">
            <button type="button" role="radio" data-mode="system" aria-checked="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" /></svg>System</button>
            <button type="button" role="radio" data-mode="light" aria-checked="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>Light</button>
            <button type="button" role="radio" data-mode="dark" aria-checked="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>Dark</button>
          </div>
        </div>
      </footer>
    </div>
    <script is:inline>
      // Mobile menu: a <details> dropdown (works without JS). JS adds Escape,
      // outside tap and focus handling.
      (function () {
        var menu = document.getElementById("site-menu");
        if (!menu) return;
        var btn = menu.querySelector("summary");
        btn.setAttribute("aria-expanded", "false");
        menu.addEventListener("toggle", function () {
          btn.setAttribute("aria-expanded", String(menu.open));
          btn.setAttribute("aria-label", menu.open ? "Close menu" : "Menu");
          if (menu.open) { var cur = menu.querySelector('.menu-main a[aria-current="page"]') || menu.querySelector(".menu-main a"); if (cur) cur.focus({ preventScroll: true }); }
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && menu.open) { menu.open = false; btn.focus(); }
        });
        document.addEventListener("click", function (e) {
          if (menu.open && (!menu.contains(e.target) || e.target === menu)) menu.open = false;
        });
        menu.addEventListener("click", function (e) {
          if (e.target.closest && e.target.closest(".menu-panel a")) menu.open = false;
        });
        // Close when the layout grows to desktop width.
        var mq = window.matchMedia("(min-width: 1041px)");
        mq.addEventListener("change", function (m) { if (m.matches) menu.open = false; });
      })();
    </script>
    <script is:inline>
      // Footer theme switch (System / Light / Dark). The search menu's "Switch theme"
      // action cycles it via the "cycle-theme" event.
      (function () {
        var group = document.getElementById("theme-switch");
        if (!group) return;
        var root = document.documentElement;
        var order = ["system", "light", "dark"];
        var buttons = group.querySelectorAll("button[data-mode]");
        function current() {
          try { return localStorage.getItem("theme") || "system"; } catch (e) { return "system"; }
        }
        function apply(mode) {
          if (mode === "system") delete root.dataset.theme;
          else root.dataset.theme = mode;
          buttons.forEach(function (b) {
            var on = b.dataset.mode === mode;
            b.setAttribute("aria-checked", String(on));
            b.tabIndex = on ? 0 : -1;
          });
        }
        function set(mode) {
          try {
            if (mode === "system") localStorage.removeItem("theme");
            else localStorage.setItem("theme", mode);
          } catch (e) {}
          apply(mode);
        }
        apply(current());
        group.addEventListener("click", function (e) {
          var b = e.target.closest && e.target.closest("button[data-mode]");
          if (b) set(b.dataset.mode);
        });
        // Radio-group keyboard pattern: arrows move and select.
        group.addEventListener("keydown", function (e) {
          var step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          var next = order[(order.indexOf(current()) + step + order.length) % order.length];
          set(next);
          group.querySelector('button[data-mode="' + next + '"]').focus();
        });
        window.addEventListener("cycle-theme", function () {
          set(order[(order.indexOf(current()) + 1) % order.length]);
        });
      })();
    </script>
  </body>
</html>
