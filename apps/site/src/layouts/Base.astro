---
import "../styles.css";
import { HeaderAuth } from "../components/HeaderAuth";
import { FooterEmail } from "../components/FooterEmail";
import { SponsorSlot } from "../components/SponsorSlot";
import { JumpToDistro } from "../components/JumpToDistro";
import { loadDistros } from "../lib/data";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jumpItems = (await loadDistros()).map((d) => ({ slug: d.slug, name: d.name, rank: d.rank }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark light" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="LinuxStatistics" />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="app">
      <header class="app-header">
        <a class="brand" href="/" aria-label="LinuxStatistics home">linux<b>stats</b></a>
        <nav class="site-nav" aria-label="Main">
          <a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Rankings</a>
          <a href="/rising/" aria-current={Astro.url.pathname.startsWith("/rising") ? "page" : undefined}>Rising</a>
          <a href="/pick/" aria-current={Astro.url.pathname.startsWith("/pick") ? "page" : undefined}>Which distro?</a>
        </nav>
        <div class="header-right">
          <JumpToDistro client:idle items={jumpItems} />
          <HeaderAuth client:only="react" />
        </div>
      </header>
      <hr class="rule" />
      <main class="app-main">
        <slot />
      </main>
      <section class="signup-band" aria-label="Monthly report">
        <div class="signup-inner">
          <div class="signup-copy">
            <h2>The State of Linux Distros, monthly</h2>
            <p>Who climbed, who fell and what changed in desktop share. One email a month, no spam.</p>
          </div>
          <FooterEmail client:visible />
        </div>
      </section>
      <footer class="app-footer">
        <div class="footer-cols">
          <div class="footer-about">
            <a class="brand" href="/" aria-label="LinuxStatistics home">linux<b>stats</b></a>
            <p class="footer-credit">
              Data from <a href="https://distrowatch.com/" rel="noreferrer">DistroWatch</a> page-hit rankings,{" "}
              <a href="https://gs.statcounter.com/" rel="noreferrer">StatCounter Global Stats</a> and{" "}
              <a href="https://github.com/" rel="noreferrer">GitHub</a>. Page hits measure interest, not installs.
            </p>
          </div>
          <nav class="footer-links" aria-label="Footer">
            <h2>Explore</h2>
            <ul>
              <li><a href="/">Rankings</a></li>
              <li><a href="/rising/">Rising this month</a></li>
              <li><a href="/compare/">Compare distros</a></li>
              <li><a href="/pick/">Which distro?</a></li>
            </ul>
          </nav>
          <nav class="footer-links" aria-label="About">
            <h2>About</h2>
            <ul>
              <li><a href="/about/ratings/">How scores work</a></li>
              <li><a href="https://github.com/linuxstatistics/linuxstatistics" rel="noreferrer">Source code (AGPL-3.0)</a></li>
            </ul>
          </nav>
          <div class="footer-sponsor">
            <h2>Sponsor</h2>
            <SponsorSlot />
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
