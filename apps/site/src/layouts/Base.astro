---
import "../styles.css";
// Preload the Latin fonts every page uses first, so text doesn't reflow when they arrive.
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import plexSansLatin from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import { HeaderAuth } from "../components/HeaderAuth";
import { FooterEmail } from "../components/FooterEmail";
import { SponsorSlot } from "../components/SponsorSlot";
import { JumpToDistro } from "../components/JumpToDistro";
import { loadDistros, loadMarketShare, loadMeta, dataDate } from "../lib/data";
import { latestLinuxShare } from "../lib/marketShare";
import { OPERATOR } from "../config/site";
import { CRYPTO_ADDRESSES, SUPPORT_LINKS, hasSupport } from "../config/support";
import { SupportBlock } from "../components/SupportBlock";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Absolute URL of a 1200×630 share image. */
  image?: string;
}

const { title, description, jsonLd, noindex = false, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const [allDistros, marketShare, meta] = await Promise.all([loadDistros(), loadMarketShare(), loadMeta()]);
const jumpItems = allDistros.map((d) => ({ slug: d.slug, name: d.name, rank: d.rank }));
// Data facts for the footer, shown on every page.
const asOf = dataDate(meta, "distrowatch");
const asOfText = asOf ? new Date(`${asOf}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) : null;
const share = latestLinuxShare(marketShare);
const year = new Date().getUTCFullYear();

const NAV = [
  { href: "/", label: "Rankings", desc: "Every distro ranked by interest" },
  { href: "/rising/", label: "Rising", desc: "Biggest climbers this month" },
  { href: "/pick/", label: "Which distro?", desc: "A few questions, three matches" },
  { href: "/switch/", label: "Switch to Linux", desc: "Coming from Windows or a Mac" },
];
const MORE = [
  { href: "/compare/", label: "Compare" },
  { href: "/desktop-share/", label: "Desktop share" },
  { href: "/data/", label: "Open data" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
import { AuthSkeleton } from "../components/Skeleton";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark light" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSansLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply a saved theme before first paint (no flash). "system" = follow the OS.
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        if (localStorage.getItem("ls_auth") === "1") document.documentElement.dataset.auth = "1";
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="LinuxStatistics" />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="app">
      <header class="app-header">
        <a class="brand" href="/" aria-label="LinuxStatistics home">
          <svg class="brand-mark" viewBox="0 0 250 250" aria-hidden="true" focusable="false">
            <circle cx="125" cy="125" r="123" class="brand-mark-disc" />
            <path d="M72 60 V190 H192" fill="none" class="brand-mark-axis" stroke-width="20" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="100" y="132" width="22" height="40" rx="4" class="brand-mark-bar" />
            <rect x="133" y="106" width="22" height="66" rx="4" class="brand-mark-bar" />
            <rect x="166" y="74" width="22" height="98" rx="4" class="brand-mark-bar" />
          </svg>
          <span class="brand-text">linux<b>stats</b></span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {NAV.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="header-right">
          <div class="jump-slot"><JumpToDistro client:idle items={jumpItems} /></div>
          <button type="button" class="theme-toggle" id="theme-toggle" data-mode="system" aria-label="Theme: follow system. Switch theme">
            <svg class="i-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" /></svg>
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
          </button>
          <div class="auth-slot"><HeaderAuth client:only="react"><AuthSkeleton slot="fallback" /></HeaderAuth></div>
          <details class="menu" id="site-menu">
            <summary class="menu-btn" aria-label="Menu">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path class="l1" d="M4 7h16" /><path class="l2" d="M4 12h16" /><path class="l3" d="M4 17h16" /></svg>
              <span>Menu</span>
            </summary>
            <div class="menu-panel">
              <nav aria-label="Main">
                <ul class="menu-main">
                  {NAV.map((n) => (
                    <li>
                      <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
                        <span class="menu-label">{n.label}</span>
                        <span class="menu-desc">{n.desc}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <ul class="menu-more">
                  {MORE.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a></li>)}
                </ul>
              </nav>
            </div>
          </details>
        </div>
      </header>
      <hr class="rule" />
      <main class="app-main">
        <slot />
      </main>
      <section class="signup-band" aria-label="Monthly report">
        <div class="signup-inner">
          <div class="signup-copy">
            <h2>The State of Linux Distros, monthly</h2>
            <p>Who climbed, who fell and what changed in desktop share. One email a month, no spam.</p>
          </div>
          <FooterEmail client:visible />
        </div>
      </section>
      <footer class="app-footer">
        <div class="footer-cols">
          <div class="footer-about">
            <p class="footer-lede">Every Linux distro, ranked by what people actually look at.</p>
            <dl class="footer-facts">
              <div><dt>Tracked</dt><dd>{allDistros.length}</dd></div>
              {share && <div><dt>Desktop share</dt><dd>{share.value.toFixed(2)}%</dd></div>}
              {asOfText && <div><dt>Captured</dt><dd><a href="https://distrowatch.com/dwres.php?resource=popularity" target="_blank" rel="noopener noreferrer">{asOfText}</a></dd></div>}
            </dl>
            <p class="footer-credit">
              The Linux distro chart: <a href="https://distrowatch.com/dwres.php?resource=popularity" target="_blank" rel="noopener noreferrer">DistroWatch</a> page-hit interest over the last 12 months, with last month's movers
              marked. Desktop share from <a href="https://gs.statcounter.com/" target="_blank" rel="noopener noreferrer">StatCounter Global Stats</a>,
              repository activity from <a href="https://github.com/" target="_blank" rel="noopener noreferrer">GitHub</a>. Page hits measure interest,
              not installs.
            </p>
          </div>
          <nav class="footer-links" aria-label="Footer">
            <h2>Explore</h2>
            <ul>
              <li><a href="/">Rankings</a></li>
              <li><a href="/rising/">Rising this month</a></li>
              <li><a href="/compare/">Compare distros</a></li>
              <li><a href="/desktop-share/">Desktop share over time</a></li>
              <li><a href="/pick/">Which distro?</a></li>
              <li><a href="/switch/">Switch from Windows or Mac</a></li>
              <li><a href="/suggest/">Suggest a distro or fix</a></li>
            </ul>
          </nav>
          <nav class="footer-links" aria-label="About">
            <h2>About</h2>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/about/ratings/">How scores work</a></li>
              <li><a href="/data/">Open data</a></li>
              <li><a href="/sponsors/">Sponsors</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms and rules</a></li>
              <li><a href="https://github.com/linuxstatistics/linuxstatistics" target="_blank" rel="noopener noreferrer">Source code (AGPL-3.0)</a></li>
            </ul>
          </nav>
          <div class="footer-sponsor">
            <h2>Sponsor</h2>
            <SponsorSlot />
            {hasSupport && (
              <>
                <h2 class="footer-subhead">Support the site</h2>
                <SupportBlock client:visible links={SUPPORT_LINKS} crypto={CRYPTO_ADDRESSES} />
              </>
            )}
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {year} {OPERATOR.name}. LinuxStatistics code is open source under AGPL-3.0; ranking data belongs to its sources.</p>
          <p><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>
        </div>
      </footer>
    </div>
    <script is:inline>
      // Mobile menu: a <details> dropdown (works without JS). JS adds Escape,
      // outside tap and focus handling.
      (function () {
        var menu = document.getElementById("site-menu");
        if (!menu) return;
        var btn = menu.querySelector("summary");
        btn.setAttribute("aria-expanded", "false");
        menu.addEventListener("toggle", function () {
          btn.setAttribute("aria-expanded", String(menu.open));
          btn.setAttribute("aria-label", menu.open ? "Close menu" : "Menu");
          if (menu.open) { var cur = menu.querySelector('.menu-main a[aria-current="page"]') || menu.querySelector(".menu-main a"); if (cur) cur.focus({ preventScroll: true }); }
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && menu.open) { menu.open = false; btn.focus(); }
        });
        document.addEventListener("click", function (e) {
          if (menu.open && (!menu.contains(e.target) || e.target === menu)) menu.open = false;
        });
        menu.addEventListener("click", function (e) {
          if (e.target.closest && e.target.closest(".menu-panel a")) menu.open = false;
        });
        // Close when the layout grows to desktop width.
        var mq = window.matchMedia("(min-width: 1041px)");
        mq.addEventListener("change", function (m) { if (m.matches) menu.open = false; });
      })();
    </script>
    <script is:inline>
      // Theme toggle: system -> light -> dark -> system.
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        var root = document.documentElement;
        var label = { system: "follow system", light: "light", dark: "dark" };
        function current() {
          try { return localStorage.getItem("theme") || "system"; } catch (e) { return "system"; }
        }
        function apply(mode) {
          if (mode === "system") delete root.dataset.theme;
          else root.dataset.theme = mode;
          btn.dataset.mode = mode;
          btn.setAttribute("aria-label", "Theme: " + label[mode] + ". Switch theme");
          btn.title = "Theme: " + label[mode];
        }
        apply(current());
        btn.addEventListener("click", function () {
          var next = { system: "light", light: "dark", dark: "system" }[current()];
          try {
            if (next === "system") localStorage.removeItem("theme");
            else localStorage.setItem("theme", next);
          } catch (e) {}
          apply(next);
        });
      })();
    </script>
  </body>
</html>
