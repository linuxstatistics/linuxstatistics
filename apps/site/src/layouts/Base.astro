---
import "../styles.css";
import { HeaderAuth } from "../components/HeaderAuth";
import { FooterEmail } from "../components/FooterEmail";
import { SponsorSlot } from "../components/SponsorSlot";
import { JumpToDistro } from "../components/JumpToDistro";
import { loadDistros, loadMarketShare, loadMeta, dataDate } from "../lib/data";
import { latestLinuxShare } from "../lib/marketShare";
import { OPERATOR } from "../config/site";
import { CRYPTO_ADDRESSES, SUPPORT_LINKS, hasSupport } from "../config/support";
import { SupportBlock } from "../components/SupportBlock";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const [allDistros, marketShare, meta] = await Promise.all([loadDistros(), loadMarketShare(), loadMeta()]);
const jumpItems = allDistros.map((d) => ({ slug: d.slug, name: d.name, rank: d.rank }));
// Data facts for the footer, shown on every page.
const asOf = dataDate(meta, "distrowatch");
const asOfText = asOf ? new Date(`${asOf}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) : null;
const share = latestLinuxShare(marketShare);
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // Apply a saved theme before first paint (no flash). "system" = follow the OS.
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="LinuxStatistics" />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="app">
      <header class="app-header">
        <a class="brand" href="/" aria-label="LinuxStatistics home">linux<b>stats</b></a>
        <nav class="site-nav" aria-label="Main">
          <a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Rankings</a>
          <a href="/rising/" aria-current={Astro.url.pathname.startsWith("/rising") ? "page" : undefined}>Rising</a>
          <a href="/pick/" aria-current={Astro.url.pathname.startsWith("/pick") ? "page" : undefined}>Which distro?</a>
        </nav>
        <div class="header-right">
          <JumpToDistro client:idle items={jumpItems} />
          <button type="button" class="theme-toggle" id="theme-toggle" data-mode="system" aria-label="Theme: follow system. Switch theme">
            <svg class="i-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" /></svg>
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
          </button>
          <HeaderAuth client:only="react" />
        </div>
      </header>
      <hr class="rule" />
      <main class="app-main">
        <slot />
      </main>
      <section class="signup-band" aria-label="Monthly report">
        <div class="signup-inner">
          <div class="signup-copy">
            <h2>The State of Linux Distros, monthly</h2>
            <p>Who climbed, who fell and what changed in desktop share. One email a month, no spam.</p>
          </div>
          <FooterEmail client:visible />
        </div>
      </section>
      <footer class="app-footer">
        <div class="footer-cols">
          <div class="footer-about">
            <a class="brand" href="/" aria-label="LinuxStatistics home">linux<b>stats</b></a>
            <p class="footer-credit">
              The Linux distro chart: <a href="https://distrowatch.com/dwres.php?resource=popularity" target="_blank" rel="noopener noreferrer">DistroWatch</a> page-hit interest over the last 12 months, with last month's movers
              marked. Desktop share from <a href="https://gs.statcounter.com/" target="_blank" rel="noopener noreferrer">StatCounter Global Stats</a>,
              repository activity from <a href="https://github.com/" target="_blank" rel="noopener noreferrer">GitHub</a>. Page hits measure interest,
              not installs.
            </p>
            <dl class="footer-facts">
              <div><dt>Tracked</dt><dd>{allDistros.length}</dd></div>
              {share && <div><dt>Desktop share</dt><dd>{share.value.toFixed(2)}%</dd></div>}
              {asOfText && <div><dt>Captured</dt><dd><a href="https://distrowatch.com/dwres.php?resource=popularity" target="_blank" rel="noopener noreferrer">{asOfText}</a></dd></div>}
            </dl>
          </div>
          <nav class="footer-links" aria-label="Footer">
            <h2>Explore</h2>
            <ul>
              <li><a href="/">Rankings</a></li>
              <li><a href="/rising/">Rising this month</a></li>
              <li><a href="/compare/">Compare distros</a></li>
              <li><a href="/pick/">Which distro?</a></li>
              <li><a href="/suggest/">Suggest a distro or fix</a></li>
            </ul>
          </nav>
          <nav class="footer-links" aria-label="About">
            <h2>About</h2>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/about/ratings/">How scores work</a></li>
              <li><a href="/sponsors/">Sponsors</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms and rules</a></li>
              <li><a href="https://github.com/linuxstatistics/linuxstatistics" target="_blank" rel="noopener noreferrer">Source code (AGPL-3.0)</a></li>
            </ul>
          </nav>
          <div class="footer-sponsor">
            <h2>Sponsor</h2>
            <SponsorSlot />
            {hasSupport && (
              <>
                <h2 class="footer-subhead">Support the site</h2>
                <SupportBlock client:visible links={SUPPORT_LINKS} crypto={CRYPTO_ADDRESSES} />
              </>
            )}
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {year} {OPERATOR.name}. LinuxStatistics code is open source under AGPL-3.0; ranking data belongs to its sources.</p>
          <p><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>
        </div>
      </footer>
    </div>
    <script is:inline>
      // Theme toggle: system -> light -> dark -> system.
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        var root = document.documentElement;
        var label = { system: "follow system", light: "light", dark: "dark" };
        function current() {
          try { return localStorage.getItem("theme") || "system"; } catch (e) { return "system"; }
        }
        function apply(mode) {
          if (mode === "system") delete root.dataset.theme;
          else root.dataset.theme = mode;
          btn.dataset.mode = mode;
          btn.setAttribute("aria-label", "Theme: " + label[mode] + ". Switch theme");
          btn.title = "Theme: " + label[mode];
        }
        apply(current());
        btn.addEventListener("click", function () {
          var next = { system: "light", light: "dark", dark: "system" }[current()];
          try {
            if (next === "system") localStorage.removeItem("theme");
            else localStorage.setItem("theme", next);
          } catch (e) {}
          apply(next);
        });
      })();
    </script>
  </body>
</html>
