{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src", "test"],
  "exclude": ["dist", "dist.next"]
}
