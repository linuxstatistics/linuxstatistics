{
  "name": "linux-statistics",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @linux-statistics/worker seed",
    "dev:api": "pnpm --filter @linux-statistics/api start",
    "dev:web": "pnpm --filter @linux-statistics/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
