{
  "name": "linux-statistics",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @linux-statistics/worker seed",
    "dev:api": "pnpm --filter @linux-statistics/api start",
    "dev:site": "pnpm --filter @linux-statistics/site dev",
    "build:site": "bash scripts/build-site.sh",
    "check:site": "bash scripts/check-site.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
